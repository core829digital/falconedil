---
import '../styles/global.css';
import { getImage, Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { company, offices, images } from '../data/site';
import { t, path, alternates, localeMeta, locales, type Lang, type RouteKey } from '../i18n';
import ogDefault from '../assets/brand/og.jpg';
import archivoFont from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';

interface Crumb { name: string; href: string }
interface Props {
  lang: Lang;
  route: RouteKey | null;
  title: string;
  description: string;
  image?: ImageMetadata;
  noindex?: boolean;
  preloader?: boolean;
  breadcrumbs?: Crumb[];
  schema?: Record<string, unknown>[];
}

const { lang, route, title, description, image = ogDefault, noindex = false, preloader = false, breadcrumbs, schema = [] } = Astro.props;
const d = t(lang);
const meta = localeMeta[lang];
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const fullTitle = title.includes('Falcon Edil') ? title : `${title} | Falcon Edil`;
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
const ogUrl = new URL(og.src, site).href;
const logo = await getImage({ src: images.emblem, width: 208, format: 'png' });
const logoUrl = new URL(logo.src, site).href;
const alts = route ? alternates(route) : [];
const homeUrl = new URL(path(lang, 'home'), site).href;
const wa = `https://wa.me/${company.whatsapp}?text=${encodeURIComponent(d.ui.whatsappMessage)}`;
const office = lang === 'bg' ? offices[1] : offices[0];

/* ---------------- Dati strutturati (schema.org) ---------------- */
const orgId = `${site.href}#organizzazione`;
const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': orgId,
    name: company.name,
    url: site.href,
    logo: logoUrl,
    email: company.email,
    vatID: `IT${company.vat}`,
    description: d.company.description,
    founder: { '@type': 'Person', name: company.founder, jobTitle: d.company.founderJob },
    sameAs: company.social.map((s) => s.href),
    subOrganization: offices.map((o) => ({ '@id': `${site.href}#sede-${o.id}` })),
  },
  ...offices.map((o, i) => ({
    '@type': 'GeneralContractor',
    '@id': `${site.href}#sede-${o.id}`,
    name: `${company.name} — ${d.offices[i].label}`,
    parentOrganization: { '@id': orgId },
    url: homeUrl,
    image: ogUrl,
    logo: logoUrl,
    telephone: o.phone.replace(/\s/g, ''),
    email: company.email,
    priceRange: '€€',
    address: {
      '@type': 'PostalAddress',
      streetAddress: o.street,
      postalCode: o.postalCode,
      addressLocality: o.city,
      addressRegion: o.region,
      addressCountry: o.countryCode,
    },
    geo: { '@type': 'GeoCoordinates', latitude: o.coords.lat, longitude: o.coords.lng },
    hasMap: o.maps,
    openingHoursSpecification: [
      {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
        opens: '07:00',
        closes: '18:00',
      },
    ],
    areaServed: ['IT', 'BG', 'FR'],
    knowsAbout: d.servicesShortList,
  })),
  {
    '@type': 'WebSite',
    '@id': `${site.href}#sito`,
    url: site.href,
    name: company.name,
    inLanguage: locales.map((l) => localeMeta[l].intl),
    publisher: { '@id': orgId },
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical}#pagina`,
    url: canonical,
    name: fullTitle,
    description,
    inLanguage: meta.intl,
    isPartOf: { '@id': `${site.href}#sito` },
    primaryImageOfPage: ogUrl,
  },
];
if (breadcrumbs?.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: d.ui.home, href: path(lang, 'home') }, ...breadcrumbs].map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: new URL(c.href, site).href,
    })),
  });
}
graph.push(...schema);
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {alts.map((a) => <link rel="alternate" hreflang={localeMeta[a.lang].hreflang} href={new URL(a.href, site).href} />)}
    {alts.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL(alts[0].href, site).href} />}
    <meta name="theme-color" content="#0f0e0c" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="author" content="Falcon Edil" />

    <link rel="preload" href={archivoFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={meta.og} />
    {locales.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={localeMeta[l].og} />)}
    <meta property="og:site_name" content="Falcon Edil" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Falcon Edil" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline define:vars={{ preloader }}>
      document.documentElement.classList.add('js');
      try {
        var conn = navigator.connection || {};
        if (
          preloader &&
          !sessionStorage.getItem('fe-loaded') &&
          matchMedia('(min-width: 1024px) and (pointer: fine)').matches &&
          !matchMedia('(prefers-reduced-motion: reduce)').matches &&
          !conn.saveData && !/(^|-)2g$/.test(conn.effectiveType || '')
        ) {
          document.documentElement.classList.add('is-loading');
        }
      } catch (e) {}
    </script>
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body data-lang={lang}>
    <a href="#contenuto" class="skip-link">{d.ui.skip}</a>

    {preloader && (
      <div class="loader" data-loader aria-hidden="true">
        <div class="loader__panel"></div>
        <div class="loader__center">
          <Image src={images.emblem} alt="" width={104} height={120} class="loader__emblem" loading="eager" />
          <div class="loader__bar"><span data-loader-bar></span></div>
          <div class="loader__meta mono">
            <span>Trinitapoli · Sofia</span>
            <span><span data-loader-count>0</span>%</span>
          </div>
        </div>
      </div>
    )}

    <Header lang={lang} route={route} />

    <main id="contenuto" tabindex="-1">
      <slot />
    </main>

    <Footer lang={lang} />

    <!-- Contatto rapido WhatsApp (desktop/tablet) -->
    <div class="wa" data-wa>
      <span class="wa__tip" aria-hidden="true">{d.ui.whatsappTooltip}</span>
      <a class="wa__btn" href={wa} target="_blank" rel="noopener" aria-label={d.ui.whatsappCta}>
        <span class="wa__ring" aria-hidden="true"></span>
        <Icon name="whatsapp" size={28} />
      </a>
    </div>

    <!-- Barra azioni (mobile) -->
    <nav class="dock" aria-label={d.ui.quickActions} data-dock>
      <a href={office.phoneHref} class="dock__icon" aria-label={`${d.ui.callNumber} ${office.phone}`}><Icon name="phone" size={20} /></a>
      <a href={wa} class="dock__icon dock__wa" target="_blank" rel="noopener" aria-label={d.ui.whatsappCta}><Icon name="whatsapp" size={22} /></a>
      <a href={path(lang, 'contact', 'preventivo')} class="dock__main"><span>{d.ui.requestQuote}</span><Icon name="arrow" size={16} /></a>
    </nav>

    <div class="cursor" aria-hidden="true" data-cursor><span data-cursor-label></span></div>

    <script>
      // Il motore di animazione (GSAP) si carica dopo il primo rendering:
      // il contenuto è visibile subito anche su telefoni lenti.
      const load = () => import('../scripts/main');
      if (document.documentElement.classList.contains('is-loading')) load();
      else if (typeof window.requestIdleCallback === 'function') window.requestIdleCallback(() => load(), { timeout: 1500 });
      else setTimeout(load, 200);
    </script>

    <style>
      /* ---------- Preloader ---------- */
      .loader { display: none; }
      :global(html.is-loading) .loader {
        display: grid;
        place-items: center;
        position: fixed;
        inset: 0;
        z-index: 1000;
        color: var(--bone);
      }
      :global(html.is-loading) { overflow: hidden; }
      .loader__panel { position: absolute; inset: 0; background: var(--ink); }
      .loader__center { position: relative; display: grid; justify-items: center; gap: 1.6rem; width: min(320px, 70vw); }
      .loader__emblem { width: 92px; height: auto; }
      .loader__bar { width: 100%; height: 1px; background: var(--line-dark); overflow: hidden; }
      .loader__bar span { display: block; height: 100%; background: var(--gold); transform: scaleX(0); transform-origin: left; }
      .loader__meta { width: 100%; display: flex; justify-content: space-between; color: rgba(242, 237, 228, 0.6); }

      /* ---------- WhatsApp ---------- */
      .wa {
        --size: 3.75rem;
        position: fixed;
        right: max(1.5rem, env(safe-area-inset-right));
        bottom: max(1.5rem, env(safe-area-inset-bottom));
        z-index: 80;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        transition: transform 0.6s var(--ease-out), opacity 0.4s;
      }
      :global(html.is-loading) .wa, :global(html.menu-locked) .wa { opacity: 0; pointer-events: none; transform: translateY(1rem) scale(0.9); }
      .wa__btn {
        position: relative;
        display: grid;
        place-items: center;
        width: var(--size);
        height: var(--size);
        border-radius: 50%;
        background: var(--wa);
        color: #fff;
        box-shadow: 0 10px 28px -8px rgba(18, 140, 69, 0.55), 0 2px 6px rgba(0, 0, 0, 0.18);
        transition: transform 0.45s var(--ease-out), background 0.3s, box-shadow 0.45s var(--ease-out);
      }
      .wa__btn :global(svg) { position: relative; z-index: 1; display: block; }
      .wa__btn:hover, .wa__btn:focus-visible { background: #179443; transform: scale(1.06); box-shadow: 0 14px 34px -8px rgba(18, 140, 69, 0.65), 0 2px 6px rgba(0, 0, 0, 0.2); }
      .wa__btn:focus-visible { outline: 2px solid var(--gold); outline-offset: 4px; }
      .wa__ring {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        border: 2px solid var(--wa);
        opacity: 0;
        animation: wa-ring 3.2s var(--ease-out) 2.5s infinite;
      }
      @keyframes wa-ring {
        0% { transform: scale(1); opacity: 0.55; }
        60%, 100% { transform: scale(1.55); opacity: 0; }
      }
      .wa__tip {
        padding: 0.65rem 1rem;
        background: var(--ink);
        color: var(--bone);
        font-size: var(--fs-sm);
        font-weight: 550;
        line-height: 1;
        white-space: nowrap;
        border-radius: 999px;
        box-shadow: 0 10px 24px -10px rgba(0, 0, 0, 0.5);
        opacity: 0;
        transform: translateX(0.6rem);
        pointer-events: none;
        transition: opacity 0.35s, transform 0.5s var(--ease-out);
      }
      .wa:hover .wa__tip, .wa:focus-within .wa__tip, :global(.wa.is-hinting) .wa__tip { opacity: 1; transform: none; }
      @media (prefers-reduced-motion: reduce) { .wa__ring { animation: none; } }

      /* ---------- Dock mobile ---------- */
      .dock { display: none; }
      @media (max-width: 720px) {
        .wa { display: none; }
        .dock {
          position: fixed;
          left: 0.75rem;
          right: 0.75rem;
          bottom: max(0.75rem, env(safe-area-inset-bottom));
          z-index: 80;
          display: grid;
          grid-template-columns: auto auto 1fr;
          gap: 0.4rem;
          padding: 0.4rem;
          background: rgba(15, 14, 12, 0.94);
          -webkit-backdrop-filter: blur(12px);
          backdrop-filter: blur(12px);
          border: 1px solid rgba(242, 237, 228, 0.1);
          border-radius: 999px;
          color: var(--bone);
          box-shadow: 0 14px 30px -12px rgba(0, 0, 0, 0.55);
          transform: translateY(170%);
          transition: transform 0.6s var(--ease-out);
        }
        :global(.dock.is-visible) { transform: none; }
        :global(html.menu-locked) .dock { transform: translateY(170%); }
        .dock a {
          display: flex; align-items: center; justify-content: center; gap: 0.5rem;
          height: 3rem; border-radius: 999px;
          font-size: var(--fs-sm); font-weight: 600;
        }
        .dock__icon { width: 3rem; box-shadow: inset 0 0 0 1px rgba(242, 237, 228, 0.18); }
        .dock__wa { background: var(--wa); color: #fff; box-shadow: none; }
        .dock__main { padding: 0 1.1rem; background: var(--gold); color: var(--ink); text-transform: uppercase; letter-spacing: 0.03em; font-size: 0.78rem !important; white-space: nowrap; }
      }

      /* ---------- Cursore ---------- */
      .cursor {
        position: fixed;
        top: 0;
        left: 0;
        z-index: 200;
        width: 10px;
        height: 10px;
        margin: -5px 0 0 -5px;
        border-radius: 50%;
        background: var(--gold);
        pointer-events: none;
        display: none;
        place-items: center;
        transition: width 0.45s var(--ease-out), height 0.45s var(--ease-out), margin 0.45s var(--ease-out), background 0.3s;
      }
      .cursor span {
        font-family: var(--f-mono);
        font-size: 0.68rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink);
        opacity: 0;
        transition: opacity 0.3s;
        text-align: center;
        padding: 0 0.4rem;
      }
      @media (hover: hover) and (pointer: fine) {
        :global(html.has-cursor) .cursor { display: grid; }
      }
      :global(.cursor.is-label) { width: 96px; height: 96px; margin: -48px 0 0 -48px; }
      :global(.cursor.is-label) span { opacity: 1; }
      :global(.cursor.is-hidden) { width: 0; height: 0; margin: 0; }
    </style>
  </body>
</html>
