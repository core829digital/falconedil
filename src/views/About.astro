---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import Stats from '../components/Stats.astro';
import Marquee from '../components/Marquee.astro';
import { images, specialistMedia, leadershipMedia, testimonialMedia, galleryMedia } from '../data/site';
import { t, path, pad, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const a = d.pages.about;
const roman = ['I', 'II', 'III'];
---
<Base
  lang={lang}
  route="about"
  title={a.metaTitle}
  description={a.metaDescription}
  image={images.emanueleFalcone2}
  breadcrumbs={[{ name: d.nav.about, href: path(lang, 'about') }]}
>
  <PageHero lang={lang} crumb={d.nav.about} eyebrow={a.heroEyebrow} title={a.heroTitle} accent={a.heroAccent} lead={a.heroLead} image={images.sicurezza} imageAlt={a.heroImgAlt}>
    <div class="hero-ctas" data-hero-in style="--d: 0.85s">
      <a href={path(lang, 'projects')} class="btn btn--gold" data-magnetic><span>{a.ctaCurrent}</span><span class="btn__icon"><Icon name="arrow" size={18} /></span></a>
      <a href={path(lang, 'contact')} class="btn btn--ghost" data-magnetic><span>{a.ctaContact}</span></a>
    </div>
  </PageHero>

  <!-- Il fondatore -->
  <section class="section founder">
    <div class="container founder__grid">
      <div class="founder__media">
        <div class="media founder__img" data-reveal="clip">
          <Img src={images.emanueleFalcone2} alt={a.founderImgAlt} sizes="(min-width: 1024px) 38vw, 100vw" />
        </div>
        <p class="founder__cap mono" data-reveal="fade">{a.founderCaption}</p>
      </div>
      <div class="founder__text">
        <p class="eyebrow" data-reveal="fade">{a.founderEyebrow}</p>
        <h2 class="h2" data-split>{a.founderTitle} <span class="serif gold">{a.founderAccent}</span></h2>
        <div class="prose" data-reveal="up">
          <p class="lead">{a.founderLead}</p>
          <p class="muted">{a.founderP1}</p>
          <p class="muted">{a.founderP2}</p>
        </div>
        <ol class="lineage" role="list" data-reveal="stagger">
          {a.lineage.map((l, i) => <li><span class="mono gold-3" aria-hidden="true">{roman[i]}</span><span>{l}</span></li>)}
        </ol>
      </div>
    </div>
  </section>

  <Marquee items={d.values} reverse speed={50} />

  <!-- Azienda dinamica -->
  <section class="section theme-bone dyn">
    <div class="container">
      <SectionHead index="01" eyebrow={a.methodEyebrow} title={a.methodTitle} accent={a.methodAccent} />
      <div class="dyn__grid">
        <div class="prose dyn__text" data-reveal="up">
          <p class="lead">{a.methodP1}</p>
          <p class="muted">{a.methodP2}</p>
        </div>
        <ul class="dyn__cards" role="list">
          <li class="dyn__card" data-reveal="up">
            <div class="media dyn__img"><Img src={images.personale} alt={a.staffImgAlt} sizes="(min-width: 1024px) 28vw, 100vw" widths={[480, 768, 1080]} /></div>
            <h3 class="h3">{a.staffTitle}</h3>
            <p class="muted">{a.staffBody}</p>
          </li>
          <li class="dyn__card" data-reveal="up" data-delay="0.1">
            <div class="media dyn__img"><Img src={images.cantiereFucci} alt={a.historyImgAlt} sizes="(min-width: 1024px) 28vw, 100vw" widths={[480, 768, 1080]} /></div>
            <h3 class="h3">{a.historyTitle}</h3>
            <p class="muted">{a.historyBody}</p>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Numeri -->
  <section class="section section--tight">
    <div class="container"><Stats lang={lang} /></div>
  </section>

  <!-- Team -->
  <section class="section theme-dark">
    <div class="container">
      <SectionHead index="02" eyebrow={a.teamEyebrow} title={a.teamTitle} accent={a.teamAccent} lead={a.teamLead} />
      <ul class="team" role="list">
        {specialistMedia.map((p, i) => (
          <li class="member" data-reveal="up" data-delay={String(i * 0.07)}>
            <div class="media member__img"><Img src={p.image} alt={`${p.name}, ${d.specialists[i]}`} sizes="(min-width: 1024px) 22vw, 50vw" widths={[360, 640]} /></div>
            <h3 class="member__name">{p.name}</h3>
            <p class="mono member__role">{d.specialists[i]}</p>
          </li>
        ))}
      </ul>
      <div class="lead-team">
        <p class="eyebrow" data-reveal="fade">{a.leadEyebrow}</p>
        <ul class="lead-team__list" role="list" data-reveal="stagger">
          {leadershipMedia.map((p, i) => (
            <li>
              <span class="lead-team__name">{p.name} <span class="lead-team__title">{d.leadership[i].title}</span></span>
              <span class="mono lead-team__role">{d.leadership[i].role}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Processo -->
  <section class="section proc" data-draw-scope>
    <div class="container">
      <SectionHead index="03" eyebrow={a.processEyebrow} title={a.processTitle} accent={a.processAccent} lead={a.processLead} />
      <div class="proc__wrap">
        <svg class="proc__line" viewBox="0 0 10 1000" preserveAspectRatio="none" aria-hidden="true">
          <path d="M5 0 V1000" class="proc__track" />
          <path d="M5 0 V1000" class="proc__fill" data-draw />
        </svg>
        <ol class="proc__steps" role="list">
          {d.process.map((s, i) => (
            <li class="step" data-step>
              <span class="step__dot" aria-hidden="true"></span>
              <span class="mono step__n">{d.ui.phase} {pad(i + 1)}</span>
              <h3 class="h2 step__t">{s.title}</h3>
              <p class="muted step__b">{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Galleria -->
  <section class="section section--tight theme-bone">
    <div class="container">
      <SectionHead index="04" eyebrow={a.galleryEyebrow} title={a.galleryTitle} accent={a.galleryAccent} align="start" />
    </div>
    <div class="strip" data-marquee="forward" data-speed="60">
      <div class="strip__track" data-marquee-track>
        {[0, 1].map((k) => galleryMedia.map((g, i) => (
          <div class="media strip__item" aria-hidden={k === 1 ? 'true' : undefined}><Img src={g} alt={k === 1 ? '' : d.gallery[i]} sizes="340px" widths={[480, 720]} /></div>
        )))}
      </div>
    </div>
  </section>

  <!-- Clienti -->
  <section class="section clients">
    <div class="container clients__grid">
      <div>
        <p class="eyebrow" data-reveal="fade">{a.clientsEyebrow}</p>
        <h2 class="h2" data-split>{a.clientsTitle} <span class="serif gold">{a.clientsAccent}</span></h2>
      </div>
      <ul class="clients__list" role="list" data-reveal="stagger">
        {testimonialMedia.map((m, i) => (
          <li><span class="clients__name">{m.name}</span><span class="mono muted">{d.testimonials[i].role} · {d.testimonials[i].place}</span></li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 0.9rem; }

  .founder__grid { display: grid; grid-template-columns: 5fr 6fr; gap: clamp(2rem, 6vw, 7rem); align-items: center; }
  .founder__img { aspect-ratio: 4 / 5; }
  .founder__cap { margin-top: 1rem; color: var(--stone-2); }
  .founder__text { display: grid; gap: 1.8rem; }
  .lineage { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line-light); }
  .lineage li { display: grid; gap: 0.4rem; padding: 1.2rem 1rem 0 0; font-weight: 600; }
  .lineage li + li { padding-left: 1rem; border-left: 1px solid var(--line-light); }
  .gold-3 { color: var(--gold-3); }
  @media (max-width: 1023px) { .founder__grid { grid-template-columns: 1fr; } .founder__media { max-width: 560px; } }
  @media (max-width: 520px) { .lineage { grid-template-columns: 1fr; } .lineage li + li { padding-left: 0; border-left: 0; } }

  .dyn__grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .dyn__text { position: sticky; top: calc(var(--header-h) + 2rem); }
  .dyn__cards { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter); }
  .dyn__card { display: grid; gap: 1rem; align-content: start; }
  .dyn__card:nth-child(2) { margin-top: clamp(0rem, 8vw, 7rem); }
  .dyn__img { aspect-ratio: 3 / 4; }
  .dyn__card p { font-size: var(--fs-sm); }
  @media (max-width: 1023px) { .dyn__grid { grid-template-columns: 1fr; } .dyn__text { position: static; } }
  @media (max-width: 600px) { .dyn__cards { grid-template-columns: 1fr; } .dyn__card:nth-child(2) { margin-top: 0; } }

  .team { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--gutter); }
  .member { display: grid; gap: 0.5rem; align-content: start; }
  .member__img { aspect-ratio: 4 / 5; margin-bottom: 0.8rem; }
  .member__img :global(img) { filter: grayscale(1); transition: filter 0.8s, transform 1.2s var(--ease-out); }
  .member:hover .member__img :global(img) { filter: grayscale(0); transform: scale(1.04); }
  .member__name { font-size: 1.2rem; font-weight: 600; letter-spacing: -0.01em; }
  .member__role { color: var(--gold-2); line-height: 1.5; }
  .lead-team { margin-top: clamp(3rem, 6vw, 5rem); padding-top: 2rem; border-top: 1px solid var(--line-dark); display: grid; grid-template-columns: 1fr 3fr; gap: var(--gutter); }
  .lead-team__list { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gutter); }
  .lead-team__list li { display: grid; gap: 0.3rem; }
  .lead-team__name { font-size: var(--fs-lg); font-weight: 600; }
  .lead-team__title { color: rgba(242,237,228,.6); font-weight: 400; }
  .lead-team__role { color: rgba(242,237,228,.7); }
  @media (max-width: 1023px) { .team { grid-template-columns: 1fr 1fr; } .lead-team { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .lead-team__list { grid-template-columns: 1fr; } }

  .proc__wrap { position: relative; padding-left: clamp(2.5rem, 8vw, 9rem); }
  .proc__line { position: absolute; left: clamp(0.5rem, 3vw, 3.5rem); top: 0; bottom: 0; width: 10px; height: 100%; overflow: visible; }
  .proc__track { stroke: var(--line-light); stroke-width: 1; vector-effect: non-scaling-stroke; fill: none; }
  .proc__fill { stroke: var(--gold); stroke-width: 2; vector-effect: non-scaling-stroke; fill: none; }
  .proc__steps { display: grid; gap: clamp(3rem, 8vw, 7rem); }
  .step { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem var(--gutter); }
  .step__t { color: var(--stone-2); transform: translateX(-0.4rem); transition: color 0.8s var(--ease-out), transform 0.8s var(--ease-out); }
  .step.is-active .step__t, html:not(.js) .step__t { color: var(--ink); transform: none; }
  .step__dot {
    position: absolute; left: calc(-1 * clamp(2.5rem, 8vw, 9rem) + clamp(0.5rem, 3vw, 3.5rem) + 5px); top: 0.6rem;
    width: 14px; height: 14px; margin-left: -7px; background: var(--paper); border: 2px solid var(--line-light); transform: rotate(45deg);
    transition: background 0.5s, border-color 0.5s;
  }
  .step.is-active .step__dot { background: var(--gold); border-color: var(--gold); }
  .step__n { grid-column: 1 / -1; color: var(--gold-3); }
  .step__b { align-self: end; max-width: 46ch; }
    @media (prefers-reduced-motion: reduce) { .step .step__t { color: var(--ink); transform: none; } .step .step__dot { background: var(--gold); border-color: var(--gold); } }
  @media (max-width: 800px) { .step { grid-template-columns: 1fr; } }

  .strip { overflow: hidden; }
  .strip__track { display: flex; gap: 1rem; width: max-content; padding-left: 1rem; }
  .strip__item { width: clamp(220px, 24vw, 340px); aspect-ratio: 3 / 4; flex-shrink: 0; }

  .clients__grid { display: grid; grid-template-columns: 1fr 1.6fr; gap: var(--gutter); align-items: start; }
  .clients__list { border-top: 1px solid var(--line-light); }
  .clients__list li { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; padding-block: 1.4rem; border-bottom: 1px solid var(--line-light); }
  .clients__name { font-size: var(--fs-xl); font-weight: 600; letter-spacing: -0.015em; }
  @media (max-width: 860px) { .clients__grid { grid-template-columns: 1fr; } }
</style>
