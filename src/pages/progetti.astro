---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import { images, projects, gallery } from '../data/site';

const done = projects.filter((p) => p.status === 'completato').length;
const live = projects.length - done;
---
<Base
  title="Progetti — Lavori completati e cantieri in corso in Italia, Francia e Bulgaria"
  description="Restauri di condomini e ville, lastrici solari, pavimentazioni industriali e nuove costruzioni: i progetti Falcon Edil a Trinitapoli, Zapponeta, Bari, Modena, Lexy-Metz, Longlaville e Plovdiv."
  image={images.condominioDopo}
  breadcrumbs={[{ name: 'Progetti', href: '/progetti/' }]}
>
  <PageHero
    crumb="Progetti"
    eyebrow="Falcon Edil…"
    title="Progetta"
    accent="il vostro futuro."
    lead="Progettiamo e costruiamo con un focus sull’innovazione e una visione a lungo termine: anticipiamo le esigenze dei clienti con soluzioni moderne, sostenibili e affidabili."
    image={images.operativita}
    imageAlt="Restauro di un condominio con piattaforma aerea a Trinitapoli"
  >
    <dl class="phero-stats" data-reveal="up" data-hero data-delay="0.7">
      <div><dt class="mono">Completati</dt><dd>{String(done).padStart(2, '0')}</dd></div>
      <div><dt class="mono">In corso</dt><dd>{String(live).padStart(2, '0')}</dd></div>
      <div><dt class="mono">Paesi</dt><dd>03</dd></div>
    </dl>
  </PageHero>

  <section class="section">
    <div class="container">
      <SectionHead index="01" eyebrow="I nostri progetti" title="Lavori completati" accent="e cantieri attivi." />

      <div class="filters" role="group" aria-label="Filtra i progetti" data-filter-bar data-reveal="up">
        <button type="button" data-filter="tutti" aria-pressed="true">Tutti <span class="mono">{projects.length}</span></button>
        <button type="button" data-filter="completato" aria-pressed="false">Lavori completati <span class="mono">{done}</span></button>
        <button type="button" data-filter="in-corso" aria-pressed="false">Lavori attuali <span class="mono">{live}</span></button>
      </div>

      <ul class="pgrid" role="list">
        {projects.map((p, i) => (
          <li class:list={['pcard', { 'pcard--wide': i % 5 === 0 }]} data-filter-item={p.status} data-reveal="up" data-delay={String((i % 2) * 0.08)}>
            <figure>
              <div class="media pcard__img" data-cursor-text={p.place}>
                <Img src={p.image} alt={`${p.title} — ${p.place}, ${p.country}`} sizes="(min-width: 900px) 50vw, 100vw" widths={[480, 768, 1080, 1440]} />
                <span class:list={['pcard__status mono', { 'is-live': p.status === 'in-corso' }]}>
                  {p.status === 'in-corso' ? 'Lavori attuali' : 'Completato'}
                </span>
              </div>
              <figcaption class="pcard__cap">
                <div>
                  <p class="mono pcard__cat">{p.category}</p>
                  <h2 class="h3">{p.title}</h2>
                </div>
                <p class="pcard__place"><Icon name="pin" size={16} /> {p.place} <span class="muted">({p.country})</span></p>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section theme-dark">
    <div class="container">
      <SectionHead index="02" eyebrow="Prima e dopo" title="La trasformazione," accent="senza filtri." lead="Due interventi di restauro documentati prima e dopo i lavori. Trascina il cursore per confrontare." />
      <div class="ba-grid">
        <BeforeAfter before={images.lastricoPrima} after={images.lastricoDopo} title="Restauro pavimentazione solare" place="Zapponeta (Italia)" />
        <BeforeAfter before={images.condominioPrima} after={images.condominioDopo} title="Restauro condominio" place="Trinitapoli (Italia)" />
      </div>
    </div>
  </section>

  <section class="section theme-bone">
    <div class="container">
      <SectionHead index="03" eyebrow="Galleria" title="Dentro" accent="i nostri cantieri." />
      <ul class="gallery" role="list">
        {gallery.map((g, i) => (
          <li class="media gallery__item" data-reveal="clip" data-delay={String((i % 3) * 0.1)}>
            <Img src={g.image} alt={g.alt} sizes="(min-width: 900px) 33vw, 50vw" widths={[480, 768, 1080]} />
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .phero-stats { display: flex; gap: clamp(1.5rem, 4vw, 4rem); margin-top: 1rem; padding-top: 1.5rem; border-top: 1px solid var(--line-dark); }
  .phero-stats dt { color: rgba(242,237,228,.6); }
  .phero-stats dd { font-size: clamp(2.2rem, 1.5rem + 2vw, 3.4rem); font-weight: 700; font-variation-settings: 'wdth' 115; letter-spacing: -0.04em; line-height: 1; margin-top: 0.4rem; }

  .filters { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .filters button {
    display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.75rem 1.2rem; border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line-light); font-size: var(--fs-sm); font-weight: 600;
    transition: background 0.3s, color 0.3s, box-shadow 0.3s;
  }
  .filters button .mono { color: var(--gold-3); }
  .filters button:hover { box-shadow: inset 0 0 0 1px var(--ink); }
  .filters button[aria-pressed='true'] { background: var(--ink); color: var(--bone); box-shadow: none; }
  .filters button[aria-pressed='true'] .mono { color: var(--gold-2); }

  .pgrid { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(2.5rem, 5vw, 4.5rem) var(--gutter); }
  .pcard[hidden] { display: none; }
  .pcard figure { display: grid; gap: 1.2rem; }
  .pcard__img { aspect-ratio: 4 / 3; }
  .pcard--wide { grid-column: 1 / -1; }
  .pcard--wide .pcard__img { aspect-ratio: 21 / 9; }
  .pcard__img :global(img) { transition: transform 1.4s var(--ease-out); }
  .pcard:hover .pcard__img :global(img) { transform: scale(1.05); }
  .pcard__status { position: absolute; left: 1rem; top: 1rem; padding: 0.45rem 0.75rem; background: rgba(15,14,12,.78); color: var(--bone); display: inline-flex; align-items: center; gap: 0.5rem; }
  .pcard__status.is-live { background: var(--gold); color: var(--ink); }
  .pcard__status.is-live::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--ink); }
  .pcard__cap { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; flex-wrap: wrap; padding-bottom: 1.2rem; border-bottom: 1px solid var(--line-light); }
  .pcard__cat { color: var(--gold-3); margin-bottom: 0.4rem; }
  .pcard__place { display: inline-flex; align-items: center; gap: 0.4rem; font-size: var(--fs-sm); font-weight: 550; }
  @media (max-width: 800px) {
    .pgrid { grid-template-columns: 1fr; }
    .pcard--wide .pcard__img { aspect-ratio: 4 / 3; }
  }

  .ba-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter); }
  @media (max-width: 800px) { .ba-grid { grid-template-columns: 1fr; } }

  .gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .gallery__item { aspect-ratio: 3 / 4; }
  .gallery__item:nth-child(3n + 2) { transform: translateY(clamp(0rem, 4vw, 3rem)); }
  @media (max-width: 700px) { .gallery { grid-template-columns: 1fr 1fr; } .gallery__item:nth-child(3n + 2) { transform: none; } }
</style>
