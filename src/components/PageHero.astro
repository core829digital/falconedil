---
import type { ImageMetadata } from 'astro';
import Img from './Img.astro';
import { t, path, type Lang } from '../i18n';
interface Props { lang: Lang; eyebrow: string; title: string; accent?: string; lead?: string; image: ImageMetadata; imageAlt: string; crumb: string; }
const { lang, eyebrow, title, accent, lead, image, imageAlt, crumb } = Astro.props;
const d = t(lang);
---
<section class="phero theme-dark" data-hero-section>
  <div class="phero__media" data-hero-media>
    <Img src={image} alt={imageAlt} priority sizes="100vw" class="phero__img" />
  </div>
  <div class="phero__shade" aria-hidden="true"></div>
  <div class="phero__grid" aria-hidden="true">
    <span data-draw-line class="v" style="left: 33.333%"></span>
    <span data-draw-line class="v" style="left: 66.666%"></span>
    <span data-draw-line class="h" style="top: 72%"></span>
  </div>
  <div class="container phero__content" data-hero-content>
    <nav aria-label={d.ui.breadcrumb} class="phero__crumb mono" data-hero-in style="--d: 0.1s">
      <a href={path(lang, 'home')}>{d.ui.home}</a> <span aria-hidden="true">/</span> <span aria-current="page">{crumb}</span>
    </nav>
    <p class="eyebrow" data-hero-in style="--d: 0.35s">{eyebrow}</p>
    <h1 class="h1" data-hero-title>{title}{accent && <> <span class="serif gold">{accent}</span></>}</h1>
    {lead && <p class="lead phero__lead" data-hero-in style="--d: 0.65s">{lead}</p>}
    <slot />
  </div>
</section>
<style>
  .phero {
    position: relative;
    min-height: min(92svh, 900px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    padding-top: calc(var(--header-h) + 3rem);
    padding-bottom: clamp(3rem, 7vw, 6rem);
  }
  .phero__media { position: absolute; inset: 0; }
  .phero__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .phero__shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(to top, rgba(15,14,12,.95) 0%, rgba(15,14,12,.55) 45%, rgba(15,14,12,.35) 100%),
      linear-gradient(to right, rgba(15,14,12,.6), transparent 70%);
  }
  .phero__grid span { position: absolute; background: var(--line-dark); }
  .phero__grid .v { top: 0; bottom: 0; width: 1px; transform-origin: top; }
  .phero__grid .h { left: 0; right: 0; height: 1px; transform-origin: left; }
  .phero__content { position: relative; display: grid; gap: 1.5rem; }
  .phero__crumb { display: flex; gap: 0.6rem; color: rgba(242,237,228,.6); }
  .phero__crumb a:hover { color: var(--gold-2); }
  .phero h1 { max-width: 16ch; }
  .phero__lead { color: rgba(242,237,228,.78); }
</style>
