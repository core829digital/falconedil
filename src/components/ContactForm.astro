---
import Icon from './Icon.astro';
import { company } from '../data/site';
import { t, path, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const f = d.form;
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || '';
const accessKey = import.meta.env.PUBLIC_FORM_ACCESS_KEY || '';
const messages = JSON.stringify({
  invalid: f.invalid,
  sent: f.sent,
  failed: f.failed,
  mailto: f.mailto,
  subject: f.subject,
  labels: { name: f.fieldName, email: f.fieldEmail, phone: f.fieldPhone, type: f.fieldType, location: f.fieldLocation },
});
---
<form
  class="form"
  data-contact-form
  data-endpoint={endpoint}
  data-access-key={accessKey || undefined}
  data-mailto={company.email}
  data-messages={messages}
  novalidate
>
  <div class="form__row">
    <div class="field">
      <input id="f-nome" name="nome" type="text" autocomplete="given-name" required placeholder=" " />
      <label for="f-nome">{f.firstName} <span aria-hidden="true">*</span></label>
    </div>
    <div class="field">
      <input id="f-cognome" name="cognome" type="text" autocomplete="family-name" required placeholder=" " />
      <label for="f-cognome">{f.lastName} <span aria-hidden="true">*</span></label>
    </div>
  </div>
  <div class="form__row">
    <div class="field">
      <input id="f-email" name="email" type="email" autocomplete="email" required placeholder=" " />
      <label for="f-email">{f.email} <span aria-hidden="true">*</span></label>
    </div>
    <div class="field">
      <input id="f-tel" name="telefono" type="tel" autocomplete="tel" placeholder=" " inputmode="tel" />
      <label for="f-tel">{f.phone}</label>
    </div>
  </div>
  <div class="form__row">
    <div class="field field--select">
      <select id="f-int" name="intervento">
        <option value="">{f.select}</option>
        {f.interventions.map((i) => <option>{i}</option>)}
      </select>
      <label for="f-int" class="is-fixed">{f.type}</label>
    </div>
    <div class="field">
      <input id="f-loc" name="localita" type="text" autocomplete="address-level2" placeholder=" " />
      <label for="f-loc">{f.location}</label>
    </div>
  </div>
  <div class="field">
    <textarea id="f-msg" name="messaggio" rows="5" required placeholder=" "></textarea>
    <label for="f-msg">{f.message} <span aria-hidden="true">*</span></label>
  </div>
  <div class="hp" aria-hidden="true">
    <label for="f-hp">{f.honeypot}</label>
    <input id="f-hp" name="azienda_web" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <div class="check">
    <input id="f-privacy" type="checkbox" name="privacy" required />
    <span class="check__box" aria-hidden="true"><Icon name="check" size={14} /></span>
    <label for="f-privacy">{f.consentBefore}<a href={path(lang, 'privacy')} class="link-line" target="_blank">{f.consentLink}</a>{f.consentAfter} <span aria-hidden="true">*</span></label>
  </div>
  <input type="hidden" name="lingua" value={lang} />
  <div class="form__foot">
    <button type="submit" class="btn btn--gold" data-magnetic>
      <span>{f.submit}</span>
      <span class="btn__icon"><Icon name="arrow" size={18} /></span>
    </button>
    <p class="form__status" data-form-status role="status" aria-live="polite"></p>
  </div>
</form>
<style>
  .form { display: grid; gap: 1.4rem; }
  .form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem; }
  .field { position: relative; }
  .field input, .field textarea, .field select {
    width: 100%;
    background: transparent;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, currentColor 35%, transparent);
    padding: 1.6rem 0 0.7rem;
    font-size: 1rem;
    border-radius: 0;
    outline: none;
    transition: border-color 0.3s;
    appearance: none;
  }
  .field select {
    cursor: pointer;
    padding-right: 1.5rem;
    background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position: calc(100% - 12px) 62%, calc(100% - 7px) 62%;
    background-size: 5px 5px;
    background-repeat: no-repeat;
  }
  .field select option { color: var(--ink); background: var(--paper); }
  .field textarea { resize: vertical; min-height: 8rem; }
  .field label {
    position: absolute; left: 0; top: 1.55rem;
    color: color-mix(in srgb, currentColor 72%, transparent);
    pointer-events: none;
    transform-origin: left top;
    transition: transform 0.45s var(--ease-out), color 0.3s;
  }
  .field input:focus, .field textarea:focus, .field select:focus { border-color: var(--gold); }
  .field input:focus-visible, .field textarea:focus-visible, .field select:focus-visible { box-shadow: 0 1px 0 0 var(--gold); }
  .field input:focus + label, .field textarea:focus + label,
  .field input:not(:placeholder-shown) + label, .field textarea:not(:placeholder-shown) + label,
  .field label.is-fixed { transform: translateY(-1.35rem) scale(0.78); color: var(--gold-2); }
  :global(.was-validated) .field :invalid { border-color: #e48a72; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .check { position: relative; display: flex; gap: 0.9rem; align-items: flex-start; font-size: var(--fs-sm); }
  .check label { cursor: pointer; }
  .check input { position: absolute; left: 0; top: 0.15rem; width: 1.3rem; height: 1.3rem; opacity: 0; margin: 0; cursor: pointer; }
  .check__box {
    flex-shrink: 0; width: 1.3rem; height: 1.3rem; margin-top: 0.15rem;
    display: grid; place-items: center;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor 55%, transparent);
    color: transparent; transition: background 0.3s, color 0.3s;
    pointer-events: none;
  }
  .check input:checked + .check__box { background: var(--gold); color: var(--ink); box-shadow: none; }
  .check input:focus-visible + .check__box { outline: 2px solid var(--gold); outline-offset: 2px; }
  :global(.was-validated) .check input:invalid + .check__box { box-shadow: inset 0 0 0 1px #e48a72; }
  .form__foot { display: flex; flex-wrap: wrap; align-items: center; gap: 1.2rem 2rem; margin-top: 0.6rem; }
  .form__status { font-size: var(--fs-sm); max-width: 46ch; }
  :global(.form__status.is-ok) { color: #8fc27f; }
  :global(.form__status.is-error) { color: #f0a08b; }
  @media (max-width: 640px) { .form__row { grid-template-columns: 1fr; } .form__foot .btn { width: 100%; justify-content: space-between; } }
</style>
