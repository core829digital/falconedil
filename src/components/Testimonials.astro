---
import { Image } from 'astro:assets';
import { testimonialMedia } from '../data/site';
import { t, type Lang } from '../i18n';
import Icon from './Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<ul class="tst" role="list" data-reveal="stagger">
  {testimonialMedia.map((m, i) => (
    <li class:list={['tst__card', { 'tst__card--offset': i % 2 === 1 }]}>
      <figure>
        <Icon name="quote" size={30} class="tst__q" />
        <blockquote><p>{d.testimonials[i].quote}</p></blockquote>
        <figcaption class="tst__who">
          <Image src={m.image} alt="" width={56} height={56} class="tst__avatar" />
          <div>
            <p class="tst__name">{m.name}</p>
            <p class="mono tst__role">{d.testimonials[i].role} · {d.testimonials[i].place}</p>
          </div>
        </figcaption>
      </figure>
    </li>
  ))}
</ul>
<style>
  .tst { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--gutter); }
  .tst__card {
    padding: clamp(1.6rem, 3vw, 2.8rem);
    background: var(--ink-2);
    border: 1px solid var(--line-dark);
    transition: border-color 0.5s, transform 0.6s var(--ease-out);
  }
  .tst__card figure { display: flex; flex-direction: column; gap: 1.6rem; height: 100%; }
  .tst__card:hover { border-color: rgba(192,138,53,.6); transform: translateY(-4px); }
  .tst__card--offset { margin-top: clamp(0rem, 6vw, 5rem); }
  .tst__card :global(.tst__q) { color: var(--gold); }
  blockquote p { font-family: var(--f-serif); font-size: clamp(1.25rem, 1rem + 0.8vw, 1.7rem); line-height: 1.32; }
  .tst__who { display: flex; align-items: center; gap: 1rem; margin-top: auto; padding-top: 1.4rem; border-top: 1px solid var(--line-dark); }
  .tst__avatar { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; }
  .tst__name { font-weight: 600; }
  .tst__role { color: rgba(242,237,228,.68); line-height: 1.5; }
  @media (max-width: 860px) { .tst { grid-template-columns: 1fr; } .tst__card--offset { margin-top: 0; } }
</style>
