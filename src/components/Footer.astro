---
import { company, offices } from '../data/site';
import { t, path, type Lang } from '../i18n';
import Icon from './Icon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const year = new Date().getFullYear();
const navKeys = ['home', 'about', 'services', 'projects', 'contact'] as const;
const wa = `https://wa.me/${company.whatsapp}?text=${encodeURIComponent(d.ui.whatsappMessage)}`;
---
<footer class="ftr theme-dark" data-footer>
  <div class="container">
    <div class="ftr__cta">
      <p class="eyebrow">{d.footer.eyebrow}</p>
      <h2 class="h1" data-split>
        {d.footer.title} <span class="serif gold">{d.footer.accent}</span>
      </h2>
      <div class="ftr__cta-actions" data-reveal="up">
        <a href={path(lang, 'contact', 'preventivo')} class="btn btn--gold" data-magnetic>
          <span>{d.ui.requestQuote}</span>
          <span class="btn__icon"><Icon name="arrow" size={18} /></span>
        </a>
        <a href={wa} class="btn btn--ghost" target="_blank" rel="noopener">
          <Icon name="whatsapp" size={18} />
          <span>{d.ui.whatsappCta}</span>
        </a>
      </div>
    </div>

    <div class="ftr__grid">
      <div class="ftr__about">
        <p class="mono gold">Falcon Edil</p>
        <p class="muted">{d.company.description}</p>
        <ul class="ftr__social" role="list">
          {company.social.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
                <Icon name={s.id} size={17} />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <nav aria-label={d.footer.navigation}>
        <p class="mono gold">{d.footer.navigation}</p>
        <ul role="list" class="ftr__list">
          {navKeys.map((k) => <li><a class="link-hover" href={path(lang, k)}>{d.nav[k]}</a></li>)}
        </ul>
      </nav>

      <div>
        <p class="mono gold">{d.footer.services}</p>
        <ul role="list" class="ftr__list">
          {d.servicesShortList.map((s) => <li><a class="link-hover" href={path(lang, 'services')}>{s}</a></li>)}
        </ul>
      </div>

      <div>
        <p class="mono gold">{d.footer.contacts}</p>
        <address class="ftr__list">
          {offices.map((o, i) => (
            <a class="link-hover" href={o.maps} target="_blank" rel="noopener">{d.offices[i].full}</a>
          ))}
          <a class="link-hover" href={`mailto:${company.email}`}>{company.email}</a>
          <a class="link-hover" href={`mailto:${company.emailFounder}`}>{company.emailFounder}</a>
          {offices.map((o) => (
            <a class="link-hover" href={o.phoneHref}>Tel. {o.countryCode} {o.phone}</a>
          ))}
        </address>
        <div class="ftr__hours">
          <Icon name="clock" size={16} />
          <div>
            {d.company.hours.map((h) => <p><span>{h.days}</span> <span class="muted">{h.time}</span></p>)}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="ftr__word" aria-hidden="true" data-footer-word>
    <span>Falcon</span><span class="gold">Edil</span>
  </div>

  <div class="container ftr__legal">
    <p>© {year} Falcon Edil ® {d.ui.rights} · {d.ui.vat} {company.vat}</p>
    <ul role="list">
      <li><a class="link-hover" href={path(lang, 'privacy')}>{d.ui.privacy}</a></li>
      <li><a class="link-hover" href={path(lang, 'cookies')}>{d.ui.cookies}</a></li>
      <li><a class="link-hover" href={path(lang, 'terms')}>{d.ui.terms}</a></li>
    </ul>
  </div>
</footer>

<style>
  .ftr { padding-top: var(--section); overflow: hidden; position: relative; }
  .ftr__cta { display: grid; gap: 2rem; padding-bottom: var(--section); border-bottom: 1px solid var(--line-dark); }
  .ftr__cta h2 { max-width: 18ch; }
  .ftr__cta-actions { display: flex; flex-wrap: wrap; gap: 1rem; }

  .ftr__grid {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr 1.1fr 1.3fr;
    gap: clamp(2rem, 4vw, 4rem);
    padding-block: clamp(3rem, 6vw, 5rem);
    font-size: var(--fs-sm);
  }
  .ftr__grid > * > .mono { margin-bottom: 1.1rem; }
  .ftr__about p.muted { max-width: 40ch; }
  .ftr__list { display: grid; gap: 0.55rem; font-style: normal; justify-items: start; }
  .link-hover { transition: color 0.3s; }
  .link-hover:hover { color: var(--gold-2); }
  .ftr__social { display: flex; gap: 0.6rem; margin-top: 1.5rem; }
  .ftr__social a {
    display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line-dark); transition: background 0.3s, color 0.3s, box-shadow 0.3s;
  }
  .ftr__social a:hover { background: var(--gold); color: var(--ink); box-shadow: none; }
  .ftr__hours { display: flex; gap: 0.6rem; margin-top: 1.4rem; color: var(--gold-2); }
  .ftr__hours p { color: var(--bone); display: flex; gap: 0.6rem; flex-wrap: wrap; }

  .ftr__word {
    display: flex;
    justify-content: center;
    gap: 0.06em;
    font-size: clamp(3rem, 11.4vw, 17rem);
    font-weight: 800;
    font-variation-settings: 'wdth' 125;
    text-transform: uppercase;
    letter-spacing: -0.05em;
    line-height: 0.78;
    white-space: nowrap;
    user-select: none;
    padding-top: 1rem;
    color: var(--ink-3);
    -webkit-text-stroke: 1px rgba(242, 237, 228, 0.12);
  }
  .ftr__word .gold { color: transparent; -webkit-text-stroke: 1px rgba(192, 138, 53, 0.65); }

  .ftr__legal {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem;
    padding-block: 1.6rem;
    border-top: 1px solid var(--line-dark);
    font-size: var(--fs-xs);
    color: rgba(242, 237, 228, 0.68);
  }
  .ftr__legal ul { display: flex; gap: 1.5rem; flex-wrap: wrap; }

  @media (max-width: 1024px) { .ftr__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .ftr__grid { grid-template-columns: 1fr; } }
  @media (min-width: 721px) { .ftr__legal { padding-right: calc(var(--gutter) + 4.5rem); } }
  @media (max-width: 720px) { .ftr__legal { padding-bottom: calc(1.6rem + 5rem + env(safe-area-inset-bottom)); } }
</style>
