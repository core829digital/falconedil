---
interface Props { items: string[]; reverse?: boolean; speed?: number; tone?: 'dark' | 'gold' | 'light'; }
const { items, reverse = false, speed = 40, tone = 'dark' } = Astro.props;
const loop = [...items, ...items];
---
<div class:list={['mq', `mq--${tone}`]} data-marquee={reverse ? 'reverse' : 'forward'} data-speed={speed} aria-hidden="true">
  <div class="mq__track" data-marquee-track>
    {[0, 1].map(() => (
      <div class="mq__group">
        {loop.map((t) => (<span class="mq__item">{t}<i class="mq__sep"></i></span>))}
      </div>
    ))}
  </div>
</div>
<style>
  .mq { overflow: hidden; padding-block: clamp(1.1rem, 2.4vw, 2rem); border-block: 1px solid var(--line-light); }
  .mq--dark { background: var(--ink); color: var(--bone); border-color: var(--line-dark); }
  .mq--gold { background: var(--gold); color: var(--ink); border: 0; }
  .mq__track { display: flex; width: max-content; will-change: transform; }
  .mq__group { display: flex; flex-shrink: 0; }
  .mq__item {
    display: inline-flex; align-items: center; gap: clamp(1.5rem, 3vw, 3rem); padding-right: clamp(1.5rem, 3vw, 3rem);
    font-size: clamp(1.6rem, 1rem + 2.6vw, 3.4rem);
    font-weight: 650; font-variation-settings: 'wdth' 115; text-transform: uppercase; letter-spacing: -0.02em; line-height: 1;
    white-space: nowrap;
  }
  .mq__item:nth-child(even) { font-family: var(--f-serif); font-style: italic; font-weight: 400; text-transform: none; font-variation-settings: normal; letter-spacing: 0; }
  .mq__sep { width: 0.55em; height: 0.55em; background: var(--gold); transform: rotate(45deg); flex-shrink: 0; }
  .mq--gold .mq__sep { background: var(--ink); }
  @media (prefers-reduced-motion: no-preference) {
    html:not(.js) .mq__track { animation: mq 50s linear infinite; }
  }
  @keyframes mq { to { transform: translateX(-50%); } }
</style>
