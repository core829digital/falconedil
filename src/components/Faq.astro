---
import { faqs } from '../data/site';
import Icon from './Icon.astro';
---
<div class="faq">
  {faqs.map((f, i) => (
    <details class="faq__item" data-accordion data-reveal="up">
      <summary>
        <span class="mono faq__n">{String(i + 1).padStart(2, '0')}</span>
        <span class="faq__q">{f.q}</span>
        <span class="faq__icon" aria-hidden="true"><Icon name="plus" size={20} /></span>
      </summary>
      <div class="faq__body" data-accordion-body>
        <div class="faq__inner prose">
          {f.a.map((p) => <p>{p}</p>)}
          {f.list && (
            <ol>
              {f.list.map(([t, d]) => <li><strong>{t}.</strong> {d}</li>)}
            </ol>
          )}
          {f.after && <p>{f.after}</p>}
        </div>
      </div>
    </details>
  ))}
</div>
<style>
  .faq { border-top: 1px solid var(--line-light); }
  .faq__item { border-bottom: 1px solid var(--line-light); }
  summary {
    list-style: none; cursor: pointer;
    display: grid; grid-template-columns: 3rem 1fr auto; align-items: center; gap: 1rem;
    padding-block: clamp(1.4rem, 2.6vw, 2.2rem);
  }
  summary::-webkit-details-marker { display: none; }
  .faq__n { color: var(--gold-3); }
  .faq__q { font-size: var(--fs-xl); font-weight: 600; letter-spacing: -0.015em; line-height: 1.15; transition: color 0.3s; }
  summary:hover .faq__q { color: var(--gold-3); }
  .faq__icon {
    width: 3rem; height: 3rem; border-radius: 50%; display: grid; place-items: center;
    box-shadow: inset 0 0 0 1px var(--line-light); transition: transform 0.6s var(--ease-out), background 0.4s, color 0.4s;
  }
  .faq__item.is-open .faq__icon, .faq__item[open] .faq__icon { transform: rotate(135deg); background: var(--ink); color: var(--bone); }
  .faq__body { overflow: hidden; }
  .faq__inner { padding: 0 0 2rem 4rem; color: var(--stone-2); }
  .faq__inner ol { margin-top: 1rem; padding-left: 1.2rem; display: grid; gap: 0.55rem; }
  .faq__inner p + ol + p { margin-top: 1rem; }
  .faq__inner strong { color: var(--ink); font-weight: 600; }
  @media (max-width: 600px) { summary { grid-template-columns: 2rem 1fr auto; } .faq__inner { padding-left: 0; } }
</style>
